{
  "enabled": true,
  "sslRequired": "external",
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 3,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(8) and digits(1) and specialChars(1) and upperCase(1) and notUsername and notEmail and passwordHistory(3)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "fr",
    "en"
  ],
  "defaultLocale": "ar",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "eventsExpiration": 7776000,
  "realm": "ehimaya-public",
  "displayName": "ء-حماية",
  "registrationAllowed": true,
  "verifyEmail": true,
  "roles": {
    "realm": [
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "citizen",
        "description": "مواطن مسجّل"
      },
      {
        "name": "volunteer",
        "description": "متطوع معتمد من الحماية المدنية"
      },
      {
        "name": "org_admin",
        "description": "مسؤول مؤسسة"
      },
      {
        "name": "org_member",
        "description": "عضو فريق سلامة"
      },
      {
        "name": "default-roles-ehimaya-public",
        "description": "Default roles",
        "composite": true,
        "composites": {
          "realm": [
            "citizen",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ehimaya-public",
    "description": "Default roles",
    "composite": true
  },
  "clients": [
    {
      "clientId": "ehimaya-api",
      "name": "e-Himaya API (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ehimaya-mobile",
      "name": "e-Himaya mobile app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "tn.ehimaya.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-ehimaya-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ehimaya-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "phone_number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "phone_number",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "phone_number_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "phone_number_verified",
            "claim.name": "phone_number_verified",
            "jsonType.label": "boolean",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ehimaya-portal",
      "name": "e-Himaya institutions portal",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-ehimaya-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ehimaya-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "directGrantFlow": "ehimaya phone direct grant",
  "authenticationFlows": [
    {
      "alias": "ehimaya phone direct grant",
      "description": "Phase A: sign-in of the mobile app with a Tunisian mobile number and an SMS code (provider ehimaya-phone-otp, infra/keycloak/providers/phone-otp).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ehimaya-phone-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],
  "loginTheme": "ehimaya"
}
