{
 "version": 8,
 "name": "e-Himaya labels over imagery (OpenMapTiles schema)",
 "metadata": {
  "ehimaya:doc": "docs/offline-maps.md"
 },
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "mbtiles://{tunisia}",
   "attribution": "© OpenStreetMap contributors · OpenMapTiles"
  }
 },
 "glyphs": "{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "road-secondary",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-join": "round",
    "line-cap": "round"
   },
   "paint": {
    "line-color": "rgba(255,255,255,0.55)",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     18,
     16
    ]
   },
   "minzoom": 8
  },
  {
   "id": "road-primary",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "primary",
     "trunk"
    ],
    true,
    false
   ],
   "layout": {
    "line-join": "round",
    "line-cap": "round"
   },
   "paint": {
    "line-color": "rgba(255,255,255,0.55)",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     6,
     0.6,
     18,
     20
    ]
   },
   "minzoom": 6
  },
  {
   "id": "road-motorway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway"
    ],
    true,
    false
   ],
   "layout": {
    "line-join": "round",
    "line-cap": "round"
   },
   "paint": {
    "line-color": "rgba(255,255,255,0.55)",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     5,
     0.8,
     18,
     22
    ]
   },
   "minzoom": 5
  },
  {
   "id": "boundary-state",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "==",
    [
     "get",
     "admin_level"
    ],
    4
   ],
   "paint": {
    "line-color": "#8c9ac8",
    "line-width": 1,
    "line-dasharray": [
     4,
     2
    ]
   }
  },
  {
   "id": "boundary-country",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "admin_level"
     ],
     2
    ],
    [
     "!=",
     [
      "get",
      "maritime"
     ],
     1
    ]
   ],
   "paint": {
    "line-color": "#1f3fa0",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     3,
     1,
     10,
     2.5
    ]
   }
  },
  {
   "id": "water-name",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "water_name",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": 12,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   }
  },
  {
   "id": "road-names",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "transportation_name",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     12,
     10,
     18,
     14
    ],
    "text-max-width": 8,
    "symbol-placement": "line",
    "text-rotation-alignment": "map"
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   },
   "minzoom": 12
  },
  {
   "id": "place-village",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 11,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   },
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "village",
     "hamlet",
     "suburb",
     "neighbourhood"
    ],
    true,
    false
   ],
   "minzoom": 11
  },
  {
   "id": "place-town",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     11,
     14,
     15
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   },
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "town"
   ],
   "minzoom": 8
  },
  {
   "id": "place-city",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     5,
     12,
     12,
     18
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   },
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "city"
   ]
  },
  {
   "id": "place-country",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ar"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 16,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#ffffff",
    "text-halo-color": "rgba(14,20,38,0.85)",
    "text-halo-width": 1.6
   },
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "country"
   ]
  }
 ]
}