# ==== ء-حماية / e-Himaya — the demonstration stack (docs/demo.md) ====
# Make the file once:   cat .env.example infra/demo/env.demo.example > .env.demo
# then change every password of .env.example and fill the values below. The last value of a name wins.

# The computer's address on the demonstration Wi-Fi (fixed: a static address or a DHCP reservation on the router).
DEMO_LAN_IP=192.168.50.10
# The scenario's gouvernorat (21 Nabeul by default; 11 Tunis and 61 Sfax have an address ready too).
DEMO_GOUVERNORAT=21
# Password of the five demonstration accounts (demo-room, demo-central, demo-committee, demo-owner, demo-citizen).
DEMO_PASSWORD=change-me-demo-password

# Local names, answered by the router's DNS or infra/demo/dnsmasq.conf.
API_HOST=api.ehimaya.demo
DASHBOARD_HOST=room.ehimaya.demo
PORTAL_HOST=portal.ehimaya.demo
AUTH_HOST=auth.ehimaya.demo
MEDIA_HOST=media.ehimaya.demo
NOTIFY_HOST=push.ehimaya.demo
CADDY_TLS=internal
TUSD_CORS_ORIGIN_REGEX=^https://(room|portal)\.ehimaya\.demo$
ALERT_EMAIL_TO=demo@ehimaya.demo

# Production-only values the overlay still asks for (random, never reused).
EHIMAYA_DB_RUNTIME_PASSWORD=change-me-runtime
OPENSEARCH_ADMIN_PASSWORD=change-me-os-admin
OPENSEARCH_PASSWORD=change-me-os-api
MEDIAMTX_HOOK_TOKEN=change-me-hook-token
MEDIAMTX_API_PASSWORD=change-me-mediamtx-api
TELEPHONY_ARI_PASSWORD=change-me-ari

# SIMULATION: the [SIM] camera of the warehouse (stream-sim). Any random value.
STREAM_SIM_TOKEN=change-me-sim-token

# A real camera (optional): a Tapo C200/C310 or any RTSP camera on the same Wi-Fi. Register it in the dashboard
# («البث المباشر» > «كاميرات المؤسسات»), then paste the publish address it shows once.
CAMERA_RTSP_URL=
CAMERA_PUBLISH_URL=
