# ==== ء-حماية / e-Himaya — متغيرات البيئة ====
# انسخ هذا الملف إلى .env وغيّر كل كلمات المرور قبل أي استعمال خارج جهاز التطوير.

# --- PostgreSQL (superuser, used only for init) ---
POSTGRES_PASSWORD=change-me-postgres

# --- Application database ---
EHIMAYA_DB_NAME=ehimaya
EHIMAYA_DB_USER=ehimaya
EHIMAYA_DB_PASSWORD=change-me-app
# Runtime role of the API (DML only; audit log append-only). The owner above only runs the migrations
# (one-shot `migrate` service). Empty password = same as EHIMAYA_DB_PASSWORD (development only; required in production).
EHIMAYA_DB_RUNTIME_USER=ehimaya_app
EHIMAYA_DB_RUNTIME_PASSWORD=

# --- Keycloak ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-kc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
# Public base URL of Keycloak as seen by browsers and phones
KEYCLOAK_HOSTNAME=http://localhost:8080

# --- Valkey ---
VALKEY_PASSWORD=change-me-valkey

# --- NATS ---
NATS_APP_USER=ehimaya
NATS_APP_PASSWORD=change-me-nats

# --- S3 object storage (SeaweedFS) ---
S3_ACCESS_KEY=ehimaya
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET_MEDIA=ehimaya-media
# Address of the object store as reached by browsers (pre-signed media links in the dashboard)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- API ---
# Secret used to derive anonymous pseudonyms (HMAC). 32+ random bytes, never rotate without a migration plan.
ANON_PSEUDONYM_SECRET=change-me-generate-with-openssl-rand-hex-32
# AES-256 key for field-level encryption of personal data at rest (CIN, phone, address, medical data, report
# text and transcripts, volunteer notes): openssl rand -base64 32. It is key version 1 and the root of the blind
# indexes (CIN, phone, report search words): keep it configured even after a rotation. Losing it loses the data.
FIELD_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# Key rotation: further versions "2:<base64>,3:<base64>"; the highest is used for new values unless
# FIELD_ENCRYPTION_ACTIVE_VERSION says otherwise. Then: python -m app.modules.privacy.cli reencrypt
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_VERSION=
# Retention (law 2004-63), run by the worker role every RETENTION_INTERVAL_S; durations in days.
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=3600
RETENTION_EVENTS_DAYS=7
RETENTION_NOTIFY_OUTBOX_DAYS=30
RETENTION_NOTIFY_DISPATCH_DAYS=180
RETENTION_DEVICE_DAYS=180
RETENTION_DEVICE_LOCATION_DAYS=30
# Closed/rejected reports are anonymised 5 years after their last change (architecture §5.3).
RETENTION_REPORT_DAYS=1826
RETENTION_CONSENT_DAYS=1826
RETENTION_ANON_ACCOUNT_DAYS=365
RETENTION_ERASURE_DAYS=30
# Secret tusd sends in the Authorization header of its hook calls (HTTP Basic, user "tusd"): openssl rand -hex 24
# (hex only: it is written into the hook URL's user-info part, which Go turns into the header).
TUSD_HOOK_SECRET=change-me-generate-with-openssl-rand-hex-24
# Reverse proxies whose X-Forwarded-For uvicorn trusts (comma-separated IPs/CIDRs, read by uvicorn itself).
# Per-address rate limits only see real client addresses when the proxy in front of the API is listed here;
# never "*" when the API port is reachable without the proxy. Default 127.0.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1
# api: HTTP only, no background loop; worker: background loops (outbox relay, media verification, AI analysis,
# notification delivery, retention) and only /health and /metrics; all: both (single-container development).
PROCESS_ROLE=all
# Bearer token of the Prometheus scraper for GET /metrics (openssl rand -hex 24). Empty = /metrics disabled (404).
METRICS_TOKEN=
# Anonymous abuse controls (registered citizens are limited per account only). Reports beyond the global
# anonymous budget are still accepted, flagged "needs verification" with a lowered priority.
ANON_IDENTITY_PER_IP=60
ANON_IDENTITY_WINDOW_S=3600
ANON_REPORT_PER_IP=60
ANON_REPORT_WINDOW_S=600
ANON_CONSENT_PER_IP=60
ANON_DEVICE_PER_IP=120
ANON_REPORT_BUDGET=300
ANON_REPORT_BUDGET_WINDOW_S=600
# Comma-separated allowed browser origins
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
API_LOG_LEVEL=INFO
# Institutions portal address, used in invitation links and on certificates (QR code to /verify/<code>)
PORTAL_PUBLIC_URL=http://localhost:5174
# Ed25519 key signing approved safety certificates: openssl rand -base64 32. Keep it secret and backed up:
# certificates signed with a lost key can no longer be verified. Empty = certificates cannot be approved.
CERTIFICATE_SIGNING_KEY=

# --- Rewards (phase 8) ---
# Public base of the API: reward certificates carry a QR code to <API_PUBLIC_URL>/api/v1/rewards/certificates/<code>
# (production: https://API_HOST). Certificates are signed with CERTIFICATE_SIGNING_KEY above.
API_PUBLIC_URL=http://localhost:8000
# Points a citizen can earn per day from automatic awards (rescues designated by staff are not counted).
REWARDS_DAILY_CAP=200
# Badge thresholds in points: bronze shows at once, silver and above after a staff confirmation.
REWARDS_BADGE_BRONZE=100
REWARDS_BADGE_SILVER=500
REWARDS_BADGE_GOLD=2000
REWARDS_BADGE_AMBASSADOR=10000

# --- Notification channels (phase 5) ---
# Each channel is optional: left empty, its deliveries are recorded as "skipped" and the others still go out.
# E-mail: Mailpit (http://localhost:8025) in development; in production the relay of the hosting provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=e-Himaya <no-reply@ehimaya.tn>
SMTP_STARTTLS=false
# ┏━━ SIMULATION ━━ push and SMS left empty below go to notify-sim (emulated Firebase Cloud Messaging and Tunisian
# ┃   SMS gateway; inbox of everything sent: http://localhost:8090). Nothing reaches a real phone.
# ┃ PRODUCTION: FCM_SERVICE_ACCOUNT=$(base64 -w0 key.json) with the key from Firebase console > Project settings >
# ┃   Service accounts > Generate new private key; FCM_API_URL=https://fcm.googleapis.com;
# ┃   SMS_HTTP_URL / SMS_HTTP_TOKEN = endpoint and token of the SMS provider contract; SMS_SENDER = registered
# ┃   sender name. Then remove the notify-sim service and the notifysim volume from infra/compose.yml.
# ┗━━━━━━━━━━━━━━━━
# Push: Firebase service-account JSON, base64-encoded (base64 -w0 service-account.json). Wins over the file below.
FCM_SERVICE_ACCOUNT=
# Service-account JSON file inside the api container. Empty = the one generated by notify-sim.
FCM_SERVICE_ACCOUNT_FILE=
# FCM HTTP v1 base URL. Empty = notify-sim (http://notify-sim:8090). Real: https://fcm.googleapis.com
FCM_API_URL=
# SMS gateway of a Tunisian operator or aggregator (JSON POST {"to","text","sender"} with a bearer token).
# Empty = notify-sim (http://notify-sim:8090/sms/send, token sim-sms-token).
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=E-HIMAYA
# SIMULATION only: numbers for which notify-sim answers 503 operator_unavailable (comma-separated).
SIM_SMS_FAIL_NUMBERS=+21698000000

# --- AI layer 1 (compose profile "ai") ---
# Token the API presents to the internal AI service: openssl rand -hex 24. Leave AI_SERVICE_URL empty to run
# without models (priority, credibility and grouping then come from the rules only).
AI_SERVICE_URL=
AI_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-24
# Model set: cpu (Whisper medium, Qwen3 4B) or prod (GPU: Whisper large-v3, Qwen3 8B, with infra/compose.gpu.yml)
AI_MODEL_PROFILE=cpu
AI_LLM_MODEL=qwen3:4b

# --- Live streaming (phase 6, docs/streaming.md) ---
# Shared secrets between MediaMTX and the API (openssl rand -hex 24 each). The hook token authenticates MediaMTX's
# path events (X-Hook-Token); the API password is how the API kicks publishers through the MediaMTX control API.
MEDIAMTX_HOOK_TOKEN=change-me-generate-with-openssl-rand-hex-24
MEDIAMTX_API_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# ICE addresses MediaMTX announces to phones/browsers (comma-separated IPs or names). Development: 127.0.0.1;
# to test from a phone on the LAN put this machine's LAN address. Production default: API_HOST.
MEDIAMTX_WEBRTC_HOSTS=
# URLs handed to clients. Development: MediaMTX's own ports; production (compose.prod.yml): https://API_HOST.
STREAM_WEBRTC_PUBLIC_URL=http://localhost:8889
STREAM_HLS_PUBLIC_URL=http://localhost:8888
# Host name in the RTSP/RTMP publish URLs given to registered drones and cameras. Empty = localhost in development,
# API_HOST in production.
STREAM_INGEST_HOST=
# A citizen stream ends after this many seconds; at most STREAM_CREATE_PER_HOUR streams per account and hour.
STREAM_MAX_DURATION_S=900
STREAM_CREATE_PER_HOUR=6
# Drone/camera streams (no report) and their recordings are deleted this many days after they ended.
RETENTION_STREAM_DAYS=365
# ┏━━ SIMULATION ━━ token of stream-sim (compose profile "sim": a simulated camera looping a sample clip).
# ┃   SIM_CLIP_URL / SIM_CLIP_SHA256 replace the default clip (CC-BY-4.0, Intel sample-videos); a clip whose
# ┃   SHA-256 differs is refused. Empty SIM_CLIP_URL in compose = default clip.
# ┃ PRODUCTION: leave STREAM_SIM_TOKEN empty (APP_ENV=production refuses to start with it).
# ┗━━━━━━━━━━━━━━━━
STREAM_SIM_TOKEN=change-me-sim-token-development-only-0001
SIM_LABEL=SIM camera
SIM_GOUVERNORAT_CODE=11

# --- Vision: fire/smoke detection (compose profile "vision") ---
# Empty VISION_SERVICE_URL = no detection (streams, recordings and uploads work the same). With the profile:
# VISION_SERVICE_URL=http://vision:8100. Tokens: openssl rand -hex 24 each.
VISION_SERVICE_URL=
VISION_API_TOKEN=change-me-generate-with-openssl-rand-hex-24
VISION_CALLBACK_TOKEN=change-me-generate-with-openssl-rand-hex-24
# MediaMTX read password of the detector (user "vision", internal RTSP only).
VISION_READ_PASSWORD=change-me-generate-with-openssl-rand-hex-24
VISION_MIN_CONFIDENCE=0.45
VISION_ALERT_CONFIDENCE=0.6

# --- Decision support (phase 7, docs/decision-support.md) ---
# Routing engine (compose profile "routing": Valhalla on OpenStreetMap Tunisia). Empty ROUTING_URL = straight-line
# estimates ("engine": "fallback"). With the profile: ROUTING_URL=http://routing:8002.
ROUTING_URL=
# Dated Geofabrik extract and its SHA-256 (routing-prepare refuses any other file): see docs/decision-support.md.
ROUTING_OSM_URL=https://download.geofabrik.de/africa/tunisia-260901.osm.pbf
ROUTING_OSM_SHA256=
ROUTING_BUILD_THREADS=2
# Incident assistant: the Ollama server of the AI layer (profile "ai"). Empty = 503 assistant_unavailable.
# With the profile: OLLAMA_URL=http://ollama:11434. ASSISTANT_MODEL defaults to AI_LLM_MODEL.
OLLAMA_URL=
ASSISTANT_MODEL=

# --- Weather layer and spread forecasts (phase 7, docs/weather-forecast.md) ---
# ┏━━ SIMULATION ━━ empty WEATHER_PROVIDER = "sim" in development and CI (deterministic simulated weather, flagged
# ┃   "simulated": true everywhere), "open-meteo" with APP_ENV=production (which refuses "sim").
# ┃ PRODUCTION: WEATHER_PROVIDER=open-meteo. The free https://api.open-meteo.com (CC BY 4.0 data) is for
# ┃   non-commercial use, 10,000 calls/day; the grid needs ~6,800/day. For an operational service either buy an API
# ┃   key (WEATHER_API_URL=https://customer-api.open-meteo.com, WEATHER_API_KEY=<key>) or self-host the Open-Meteo
# ┃   server and point WEATHER_API_URL at it (no key).
# ┗━━━━━━━━━━━━━━━━
WEATHER_PROVIDER=
WEATHER_API_URL=https://api.open-meteo.com
WEATHER_API_KEY=
# Seconds between refresh cycles of the 0.25° grid (each point is re-fetched at most once an hour).
WEATHER_REFRESH_INTERVAL_S=1800
# Terrain model (Copernicus DEM GLO-90): `docker compose --profile terrain run --rm terrain` installs it once into
# the "terrain" volume (~150 MB download). Without it forecasts assume a flat terrain and say so.

# --- Analytics and reports (phase 8, docs/api/phase-8-contract.md §1) ---
# k-anonymity floor of exported PDF/XLSX documents: a count below it is printed "<N".
ANALYTICS_MIN_CELL=5
# Monte Carlo runs of a what-if scenario (≥ 200) and seconds between two cycles of the "analytics" worker loop
# (scheduled reports, document generation).
ANALYTICS_SCENARIO_RUNS=200
ANALYTICS_INTERVAL_S=60

# --- National memory and events library (phase 8, docs/api/phase-8-contract.md §2) ---
# OpenSearch runs with compose profile "search" (always in production). Two random, distinct passwords of at least
# 16 characters (openssl rand -hex 24 each): "admin" (operations only) and the API's user. OpenSearch refuses to
# start without them; there is no default password. Changing one in .env takes effect on the next restart.
# Development: set OPENSEARCH_URL=https://opensearch:9200 with the profile on; empty = PostgreSQL full-text fallback
# (SEARCH_BACKEND=postgres forces it). Production: OPENSEARCH_URL is set by infra/compose.prod.yml.
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=
OPENSEARCH_USER=ehimaya
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=ehimaya
# JVM heap and container memory (heap at most half of it). Defaults: 512m / 1g, production 1g / 2g.
# OPENSEARCH_HEAP=512m
# OPENSEARCH_MEM_LIMIT=1g
LIBRARY_SEARCH_PER_MINUTE=60

# --- Telephony and SMS reports (phase 7, docs/telephony.md) ---
# ARI password between the API and Asterisk (openssl rand -hex 24). ARI is never published outside the host.
TELEPHONY_ARI_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# Address Asterisk announces to trunks and browsers (SDP/ICE): 127.0.0.1 in development, the public IP in production
# (default API_HOST). RTP range published for call media (open it in the firewall, UDP).
TELEPHONY_EXTERNAL_HOST=
TELEPHONY_RTP_START=10000
TELEPHONY_RTP_END=10099
# WebSocket SIP URL handed to the dashboard softphone. Production (compose.prod.yml): wss://API_HOST/telephony/ws.
TELEPHONY_WS_PUBLIC_URL=ws://localhost:8088/ws
# STUN/TURN servers for the softphone, comma-separated (empty: host candidates only, enough on a LAN).
TELEPHONY_ICE_SERVERS=
# Calls are recorded after the recorded-call notice (ar, fr). Empty = true in development, false in production
# (compose.prod.yml): set true in production only once the processing is declared to the INPDP (legal point L04).
TELEPHONY_RECORDING_ENABLED=
# Call metadata and recordings are deleted after this many days (at most 730, two years).
RETENTION_CALL_DAYS=730
# SIP trunk of the operator (Tunisie Telecom, Ooredoo, Orange): empty TELEPHONY_TRUNK_HOST = no trunk (scenario 0/1).
# Set TELEPHONY_TRUNK_ENABLED=true for the API once the trunk is configured (outbound calls, invitations).
TELEPHONY_TRUNK_ENABLED=false
TELEPHONY_TRUNK_HOST=
TELEPHONY_TRUNK_PORT=5060
TELEPHONY_TRUNK_TRANSPORT=udp
TELEPHONY_TRUNK_USERNAME=
TELEPHONY_TRUNK_PASSWORD=
TELEPHONY_TRUNK_DOMAIN=
TELEPHONY_TRUNK_MATCH=
TELEPHONY_TRUNK_REGISTER=false
TELEPHONY_TRUNK_CODECS=alaw,ulaw
TELEPHONY_TRUNK_MEDIA_ENCRYPTION=no
TELEPHONY_TRUNK_NUMBER_FORMAT=e164
TELEPHONY_TRUNK_CALLER_ID=
# Scenario 2 (transfer to 198 through the trunk): only with a signed agreement and regulatory review (docs/telephony.md).
TELEPHONY_TRANSFER_198_ENABLED=false
TELEPHONY_TRUNK_198_NUMBER=198
# SMS reports (FR-A-048): HMAC secret shared with the SMS gateway posting to /internal/sms/inbound
# (openssl rand -hex 32). Empty = the webhook answers 404.
SMS_INBOUND_SECRET=
SMS_DEDUP_WINDOW_H=48
# ┏━━ SIMULATION ━━ call-sim (compose profile "sim") places a call to 8000 every CALL_SIM_INTERVAL_S seconds and answers
# ┃   outbound calls while there is no trunk; TELEPHONY_SIM_PASSWORD is its SIP password (openssl rand -hex 24) and
# ┃   TELEPHONY_SIM_TOKEN lets the smoke test read /internal/sim/calls.
# ┃ PRODUCTION: leave both empty (APP_ENV=production refuses TELEPHONY_SIM_TOKEN; no simulator endpoint exists).
# ┗━━━━━━━━━━━━━━━━
TELEPHONY_SIM_PASSWORD=change-me-sim-sip-password-development-0001
TELEPHONY_SIM_TOKEN=change-me-telephony-sim-token-development-01
CALL_SIM_INTERVAL_S=300
