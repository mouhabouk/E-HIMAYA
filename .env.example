# ==== ء-حماية / e-Himaya — متغيرات البيئة ====
# انسخ هذا الملف إلى .env وغيّر كل كلمات المرور قبل أي استعمال خارج جهاز التطوير.

# --- PostgreSQL (superuser, used only for init) ---
POSTGRES_PASSWORD=change-me-postgres

# --- Application database ---
EHIMAYA_DB_NAME=ehimaya
EHIMAYA_DB_USER=ehimaya
EHIMAYA_DB_PASSWORD=change-me-app

# --- Keycloak ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-kc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
# Public base URL of Keycloak as seen by browsers and phones
KEYCLOAK_HOSTNAME=http://localhost:8080

# --- Valkey ---
VALKEY_PASSWORD=change-me-valkey

# --- NATS ---
NATS_APP_USER=ehimaya
NATS_APP_PASSWORD=change-me-nats

# --- S3 object storage (SeaweedFS) ---
S3_ACCESS_KEY=ehimaya
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET_MEDIA=ehimaya-media
# Address of the object store as reached by browsers (pre-signed media links in the dashboard)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- API ---
# Secret used to derive anonymous pseudonyms (HMAC). 32+ random bytes, never rotate without a migration plan.
ANON_PSEUDONYM_SECRET=change-me-generate-with-openssl-rand-hex-32
# AES-256 key for field-level encryption (CIN, medical data): openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# Secret in the URL tusd uses to call the API hooks: openssl rand -hex 24
TUSD_HOOK_SECRET=change-me-generate-with-openssl-rand-hex-24
# Comma-separated allowed browser origins
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
API_LOG_LEVEL=INFO
# Institutions portal address, used in invitation links and on certificates (QR code to /verify/<code>)
PORTAL_PUBLIC_URL=http://localhost:5174
# Ed25519 key signing approved safety certificates: openssl rand -base64 32. Keep it secret and backed up:
# certificates signed with a lost key can no longer be verified. Empty = certificates cannot be approved.
CERTIFICATE_SIGNING_KEY=

# --- AI layer 1 (compose profile "ai") ---
# Token the API presents to the internal AI service: openssl rand -hex 24. Leave AI_SERVICE_URL empty to run
# without models (priority, credibility and grouping then come from the rules only).
AI_SERVICE_URL=
AI_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-24
# Model set: cpu (Whisper medium, Qwen3 4B) or prod (GPU: Whisper large-v3, Qwen3 8B, with infra/compose.gpu.yml)
AI_MODEL_PROFILE=cpu
AI_LLM_MODEL=qwen3:4b
