{
  "name": "@ehimaya/dashboard",
  "private": true,
  "version": "0.2.0",
  "description": "e-Himaya central dashboard (staff): KPIs, incidents, live map",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-query": "5.104.4",
    "dompurify": "3.4.17",
    "hls.js": "1.7.3",
    "i18next": "26.5.2",
    "jssip": "3.13.8",
    "maplibre-gl": "6.14.0",
    "markdown-it": "15.0.3",
    "oidc-client-ts": "3.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router": "8.4.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
