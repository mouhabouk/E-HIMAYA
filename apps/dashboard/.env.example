# e-Himaya dashboard — copy to .env.local and adjust. Every value has a dev default.
# Base URL of the API (REST + WebSocket; ws/wss is derived from it).
VITE_API_BASE_URL=http://localhost:8000
# Keycloak staff realm (issuer) and public client (Authorization Code + PKCE).
VITE_OIDC_ISSUER=http://localhost:8080/realms/ehimaya-staff
VITE_OIDC_CLIENT_ID=ehimaya-dashboard
# Optional MapLibre style URL (vector tiles). Empty = built-in raster style using OpenStreetMap tiles.
VITE_MAP_STYLE_URL=
