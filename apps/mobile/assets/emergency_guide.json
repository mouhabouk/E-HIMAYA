{
  "revision": 0,
  "topics": [
    {
      "id": "seed-fire",
      "key": "fire",
      "title": {
        "ar": "الحرائق",
        "fr": "Incendies",
        "en": "Fires"
      },
      "icon": "fire",
      "colour": "#BF360C",
      "items": [
        {
          "id": "seed-fire-0",
          "content": {
            "ar": {
              "title": "حريق في المنزل",
              "call": [
                "دخان أو لهب لا يمكن إطفاؤه في ثوانٍ"
              ],
              "steps": [
                "أخرج الجميع وأغلق الأبواب خلفك",
                "انخفض تحت الدخان",
                "اتصل بـ198 من الخارج"
              ],
              "dont": [
                "لا تستعمل المصعد",
                "لا تعد إلى الداخل"
              ]
            },
            "fr": {
              "title": "Feu dans la maison",
              "call": [
                "Fumée ou flammes impossibles à éteindre en quelques secondes"
              ],
              "steps": [
                "Faites sortir tout le monde, fermez les portes derrière vous",
                "Baissez-vous sous la fumée",
                "Appelez le 198 depuis l’extérieur"
              ],
              "dont": [
                "N’utilisez pas l’ascenseur",
                "Ne retournez pas à l’intérieur"
              ]
            },
            "en": {
              "title": "Fire at home",
              "call": [
                "Smoke or flames you cannot put out within seconds"
              ],
              "steps": [
                "Get everyone out, close the doors behind you",
                "Stay low under the smoke",
                "Call 198 from outside"
              ],
              "dont": [
                "Do not use the lift",
                "Do not go back inside"
              ]
            }
          },
          "call_198": true,
          "validated": false
        },
        {
          "id": "seed-fire-1",
          "content": {
            "ar": {
              "title": "اشتعال الملابس",
              "call": [
                "حروق واسعة بعد الإطفاء"
              ],
              "steps": [
                "توقف، انبطح أرضًا، غطّ وجهك وتدحرج",
                "برّد الحرق بماء جارٍ"
              ],
              "dont": [
                "لا تركض"
              ]
            },
            "fr": {
              "title": "Vêtements en feu",
              "call": [
                "Brûlures étendues après l’extinction"
              ],
              "steps": [
                "Arrêtez-vous, couchez-vous, couvrez votre visage et roulez",
                "Refroidissez la brûlure à l’eau courante"
              ],
              "dont": [
                "Ne courez pas"
              ]
            },
            "en": {
              "title": "Clothes on fire",
              "call": [
                "Large burns once the fire is out"
              ],
              "steps": [
                "Stop, drop to the ground, cover your face and roll",
                "Cool the burn under running water"
              ],
              "dont": [
                "Do not run"
              ]
            }
          },
          "call_198": false,
          "validated": false
        },
        {
          "id": "seed-fire-2",
          "content": {
            "ar": {
              "title": "تسرب الغاز",
              "call": [
                "رائحة غاز قوية أو شخص فاقد للوعي"
              ],
              "steps": [
                "افتح النوافذ",
                "أغلق صمام الغاز إن أمكن دون خطر",
                "غادر واتصل بـ198 من الخارج"
              ],
              "dont": [
                "لا تشعل نارًا ولا تشغّل أو تطفئ أي مفتاح كهربائي"
              ]
            },
            "fr": {
              "title": "Fuite de gaz",
              "call": [
                "Forte odeur de gaz ou personne inconsciente"
              ],
              "steps": [
                "Ouvrez les fenêtres",
                "Fermez le robinet de gaz si c’est sans danger",
                "Sortez et appelez le 198 depuis l’extérieur"
              ],
              "dont": [
                "N’allumez pas de flamme, ne touchez à aucun interrupteur"
              ]
            },
            "en": {
              "title": "Gas leak",
              "call": [
                "Strong smell of gas or someone unconscious"
              ],
              "steps": [
                "Open the windows",
                "Close the gas valve if it is safe",
                "Leave and call 198 from outside"
              ],
              "dont": [
                "No flame, do not touch any electric switch"
              ]
            }
          },
          "call_198": true,
          "validated": false
        }
      ]
    },
    {
      "id": "seed-fracture",
      "key": "fracture",
      "title": {
        "ar": "الكسور",
        "fr": "Fractures",
        "en": "Fractures"
      },
      "icon": "bone",
      "colour": "#5D4037",
      "items": [
        {
          "id": "seed-fracture-0",
          "content": {
            "ar": {
              "title": "اشتباه في كسر",
              "call": [
                "عضو مشوَّه أو جرح مفتوح أو عجز عن الحركة"
              ],
              "steps": [
                "ثبّت العضو في وضعه",
                "اسنده بقطعة قماش",
                "ضع بردًا ملفوفًا في قماش"
              ],
              "dont": [
                "لا تحاول تقويم العضو"
              ]
            },
            "fr": {
              "title": "Fracture suspectée",
              "call": [
                "Membre déformé, plaie ouverte ou impossibilité de bouger"
              ],
              "steps": [
                "Gardez le membre immobile dans sa position",
                "Calez-le avec un tissu",
                "Appliquez du froid enveloppé dans un linge"
              ],
              "dont": [
                "N’essayez pas de remettre le membre droit"
              ]
            },
            "en": {
              "title": "Suspected fracture",
              "call": [
                "Deformed limb, open wound or unable to move"
              ],
              "steps": [
                "Keep the limb still as found",
                "Support it with padding",
                "Apply cold wrapped in a cloth"
              ],
              "dont": [
                "Do not try to straighten the limb"
              ]
            }
          },
          "call_198": false,
          "validated": false
        },
        {
          "id": "seed-fracture-1",
          "content": {
            "ar": {
              "title": "إصابة الظهر أو الرقبة",
              "call": [
                "سقوط من علو أو حادث مرور"
              ],
              "steps": [
                "لا تحرّك المصاب إلا في حالة خطر",
                "ثبّت الرأس والرقبة",
                "أبقِه دافئًا وطمئنه"
              ],
              "dont": [
                "لا تعطه أكلًا ولا شربًا"
              ]
            },
            "fr": {
              "title": "Blessure au dos ou au cou",
              "call": [
                "Chute de hauteur ou accident de la route"
              ],
              "steps": [
                "Ne déplacez pas la victime sauf danger",
                "Maintenez la tête et le cou",
                "Couvrez-la, rassurez-la"
              ],
              "dont": [
                "Ne lui donnez ni à manger ni à boire"
              ]
            },
            "en": {
              "title": "Back or neck injury",
              "call": [
                "Fall from a height or road accident"
              ],
              "steps": [
                "Do not move the person unless in danger",
                "Keep the head and neck still",
                "Keep them warm and reassure them"
              ],
              "dont": [
                "Give no food or drink"
              ]
            }
          },
          "call_198": true,
          "validated": false
        }
      ]
    },
    {
      "id": "seed-first_aid",
      "key": "first_aid",
      "title": {
        "ar": "الإسعافات الأولية",
        "fr": "Premiers secours",
        "en": "First aid"
      },
      "icon": "first_aid",
      "colour": "#C62828",
      "items": [
        {
          "id": "seed-first_aid-0",
          "content": {
            "ar": {
              "title": "شخص لا يستجيب ولا يتنفس",
              "call": [
                "دائمًا: اتصل بـ198 فورًا"
              ],
              "steps": [
                "اتصل بـ198 وشغّل مكبر الصوت",
                "اضغط بقوة وسرعة وسط الصدر (100 إلى 120 في الدقيقة)",
                "واصل حتى وصول النجدة"
              ],
              "dont": [
                "لا تتوقف إلا إذا تنفس الشخص أو تولى غيرك"
              ]
            },
            "fr": {
              "title": "Personne qui ne répond pas et ne respire pas",
              "call": [
                "Toujours : appelez le 198 immédiatement"
              ],
              "steps": [
                "Appelez le 198, mettez le haut-parleur",
                "Appuyez fort et vite au centre de la poitrine (100 à 120 par minute)",
                "Continuez jusqu’à l’arrivée des secours"
              ],
              "dont": [
                "N’arrêtez pas sauf si la personne respire ou qu’on vous relaie"
              ]
            },
            "en": {
              "title": "Unresponsive and not breathing",
              "call": [
                "Always: call 198 at once"
              ],
              "steps": [
                "Call 198, put the phone on speaker",
                "Push hard and fast in the centre of the chest (100 to 120 a minute)",
                "Keep going until help arrives"
              ],
              "dont": [
                "Do not stop unless the person breathes or someone takes over"
              ]
            }
          },
          "call_198": true,
          "validated": false
        },
        {
          "id": "seed-first_aid-1",
          "content": {
            "ar": {
              "title": "شخص فاقد للوعي يتنفس",
              "call": [
                "فقدان الوعي"
              ],
              "steps": [
                "ضعه على جنبه والرأس مائل إلى الخلف",
                "راقب تنفسه باستمرار"
              ],
              "dont": [
                "لا تتركه وحده"
              ]
            },
            "fr": {
              "title": "Personne inconsciente qui respire",
              "call": [
                "Perte de connaissance"
              ],
              "steps": [
                "Mettez-la sur le côté, tête basculée en arrière",
                "Surveillez sa respiration"
              ],
              "dont": [
                "Ne la laissez pas seule"
              ]
            },
            "en": {
              "title": "Unconscious but breathing",
              "call": [
                "Loss of consciousness"
              ],
              "steps": [
                "Turn them on their side, head tilted back",
                "Keep checking their breathing"
              ],
              "dont": [
                "Do not leave them alone"
              ]
            }
          },
          "call_198": true,
          "validated": false
        }
      ]
    },
    {
      "id": "seed-breathing",
      "key": "breathing",
      "title": {
        "ar": "المشاكل التنفسية",
        "fr": "Problèmes respiratoires",
        "en": "Breathing problems"
      },
      "icon": "lungs",
      "colour": "#1565C0",
      "items": [
        {
          "id": "seed-breathing-0",
          "content": {
            "ar": {
              "title": "الاختناق بجسم غريب",
              "call": [
                "لا يستطيع الكلام ولا السعال"
              ],
              "steps": [
                "شجّعه على السعال",
                "حتى 5 ضربات بين الكتفين",
                "حتى 5 ضغطات على البطن"
              ],
              "dont": [
                "لا تُدخل أصابعك في فمه دون رؤية الجسم"
              ]
            },
            "fr": {
              "title": "Étouffement",
              "call": [
                "Ne peut ni parler ni tousser"
              ],
              "steps": [
                "Encouragez-la à tousser",
                "Jusqu’à 5 tapes dans le dos entre les omoplates",
                "Jusqu’à 5 compressions abdominales"
              ],
              "dont": [
                "Ne mettez pas les doigts dans la bouche à l’aveugle"
              ]
            },
            "en": {
              "title": "Choking",
              "call": [
                "Cannot speak or cough"
              ],
              "steps": [
                "Encourage them to cough",
                "Up to 5 back blows between the shoulder blades",
                "Up to 5 abdominal thrusts"
              ],
              "dont": [
                "Do not sweep the mouth blindly"
              ]
            }
          },
          "call_198": true,
          "validated": false
        },
        {
          "id": "seed-breathing-1",
          "content": {
            "ar": {
              "title": "نوبة ربو",
              "call": [
                "لا تحسّن بعد البخاخ أو شفاه زرقاء"
              ],
              "steps": [
                "أجلسه مستقيمًا",
                "استعمل بخاخ الإسعاف",
                "حافظ على هدوئه"
              ],
              "dont": [
                "لا تجعله يستلقي"
              ]
            },
            "fr": {
              "title": "Crise d’asthme",
              "call": [
                "Pas d’amélioration après l’inhalateur ou lèvres bleues"
              ],
              "steps": [
                "Asseyez-la bien droite",
                "Utilisez son inhalateur de secours",
                "Gardez-la calme"
              ],
              "dont": [
                "Ne l’allongez pas"
              ]
            },
            "en": {
              "title": "Asthma attack",
              "call": [
                "No better after the inhaler, or blue lips"
              ],
              "steps": [
                "Sit them upright",
                "Use their reliever inhaler",
                "Keep them calm"
              ],
              "dont": [
                "Do not lay them down"
              ]
            }
          },
          "call_198": false,
          "validated": false
        },
        {
          "id": "seed-breathing-2",
          "content": {
            "ar": {
              "title": "استنشاق الدخان",
              "call": [
                "سعال شديد أو ضيق تنفس أو صداع"
              ],
              "steps": [
                "انقله إلى الهواء الطلق",
                "أجلسه وراقبه"
              ],
              "dont": [
                "لا تدخل مكانًا مليئًا بالدخان"
              ]
            },
            "fr": {
              "title": "Inhalation de fumée",
              "call": [
                "Toux forte, gêne respiratoire ou maux de tête"
              ],
              "steps": [
                "Amenez-la à l’air libre",
                "Asseyez-la et surveillez-la"
              ],
              "dont": [
                "N’entrez pas dans un local enfumé"
              ]
            },
            "en": {
              "title": "Smoke inhalation",
              "call": [
                "Heavy cough, short of breath or headache"
              ],
              "steps": [
                "Move them to fresh air",
                "Sit them down and watch them"
              ],
              "dont": [
                "Do not enter a smoke-filled place"
              ]
            }
          },
          "call_198": true,
          "validated": false
        }
      ]
    },
    {
      "id": "seed-burns",
      "key": "burns",
      "title": {
        "ar": "الحروق",
        "fr": "Brûlures",
        "en": "Burns"
      },
      "icon": "burn",
      "colour": "#AD1457",
      "items": [
        {
          "id": "seed-burns-0",
          "content": {
            "ar": {
              "title": "حرق حراري",
              "call": [
                "حرق واسع أو في الوجه أو اليدين أو لدى طفل"
              ],
              "steps": [
                "برّد الحرق بماء جارٍ 20 دقيقة",
                "انزع الخواتم والملابس غير الملتصقة",
                "غطّه بقطعة قماش نظيفة"
              ],
              "dont": [
                "لا ثلج ولا معجون ولا زبدة",
                "لا تفقأ الفقاعات"
              ]
            },
            "fr": {
              "title": "Brûlure thermique",
              "call": [
                "Brûlure étendue, au visage, aux mains ou chez un enfant"
              ],
              "steps": [
                "Refroidissez 20 minutes à l’eau courante",
                "Retirez bagues et vêtements non collés",
                "Couvrez d’un linge propre"
              ],
              "dont": [
                "Ni glace, ni dentifrice, ni beurre",
                "Ne percez pas les cloques"
              ]
            },
            "en": {
              "title": "Heat burn",
              "call": [
                "Large burn, on the face or hands, or a child"
              ],
              "steps": [
                "Cool for 20 minutes under running water",
                "Remove rings and clothing that is not stuck",
                "Cover with a clean cloth"
              ],
              "dont": [
                "No ice, toothpaste or butter",
                "Do not burst blisters"
              ]
            }
          },
          "call_198": false,
          "validated": false
        }
      ]
    },
    {
      "id": "seed-bleeding",
      "key": "bleeding",
      "title": {
        "ar": "النزيف",
        "fr": "Saignements",
        "en": "Bleeding"
      },
      "icon": "drop",
      "colour": "#6A1B9A",
      "items": [
        {
          "id": "seed-bleeding-0",
          "content": {
            "ar": {
              "title": "نزيف حاد",
              "call": [
                "دم يتدفق بغزارة"
              ],
              "steps": [
                "اضغط بقوة على الجرح بقماش نظيف",
                "واصل الضغط دون توقف",
                "مدّد المصاب"
              ],
              "dont": [
                "لا تنزع جسمًا مغروسًا في الجرح"
              ]
            },
            "fr": {
              "title": "Saignement abondant",
              "call": [
                "Le sang coule en abondance"
              ],
              "steps": [
                "Appuyez fort sur la plaie avec un linge propre",
                "Maintenez la pression sans relâcher",
                "Allongez la victime"
              ],
              "dont": [
                "Ne retirez pas un objet planté dans la plaie"
              ]
            },
            "en": {
              "title": "Severe bleeding",
              "call": [
                "Blood is flowing heavily"
              ],
              "steps": [
                "Press hard on the wound with a clean cloth",
                "Keep pressing without letting go",
                "Lay the person down"
              ],
              "dont": [
                "Do not remove an object stuck in the wound"
              ]
            }
          },
          "call_198": true,
          "validated": false
        },
        {
          "id": "seed-bleeding-1",
          "content": {
            "ar": {
              "title": "نزيف الأنف",
              "call": [
                "لا يتوقف بعد 20 دقيقة"
              ],
              "steps": [
                "اجلس وأمِل الرأس إلى الأمام",
                "اضغط على الجزء اللين من الأنف 10 دقائق"
              ],
              "dont": [
                "لا تُمِل الرأس إلى الخلف"
              ]
            },
            "fr": {
              "title": "Saignement de nez",
              "call": [
                "Ne s’arrête pas après 20 minutes"
              ],
              "steps": [
                "Asseyez-vous, penchez la tête en avant",
                "Pincez la partie molle du nez 10 minutes"
              ],
              "dont": [
                "Ne basculez pas la tête en arrière"
              ]
            },
            "en": {
              "title": "Nosebleed",
              "call": [
                "Does not stop after 20 minutes"
              ],
              "steps": [
                "Sit down, lean the head forward",
                "Pinch the soft part of the nose for 10 minutes"
              ],
              "dont": [
                "Do not tilt the head back"
              ]
            }
          },
          "call_198": false,
          "validated": false
        }
      ]
    }
  ]
}
