# e-Himaya institutions portal — copy to .env.local and adjust. Every value has a dev default.
# Base URL of the API.
VITE_API_BASE_URL=http://localhost:8000
# Keycloak public realm (issuer) and the portal's public client (Authorization Code + PKCE).
VITE_OIDC_ISSUER=http://localhost:8080/realms/ehimaya-public
VITE_OIDC_CLIENT_ID=ehimaya-portal
# tus 1.0 endpoint for document uploads (tusd; the trailing slash matters).
VITE_TUS_ENDPOINT=http://localhost:1080/api/v1/uploads/
# Optional MapLibre style URL (vector tiles). Empty = built-in raster style using OpenStreetMap tiles.
VITE_MAP_STYLE_URL=
