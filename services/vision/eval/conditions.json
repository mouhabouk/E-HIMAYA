{
 "about": "Condition tags of the fire and smoke positives of eval/samples.json, for the false-negative rates by condition (docs/phase-l/design-l5.md §4.1). Tagged by eye on thumbnails in a development session on 2026-10-29, before the detector was run on them, and not yet reviewed by a second person. null: an artwork or abstract picture, left out of every condition (still counted in EVALUATION.md). A null setting: a close-up that shows neither inside nor outside.",
 "definitions": {
  "light": {
   "day": "scene lit by daylight or bright room light",
   "night": "dark scene lit mainly by the fire, a lamp or a flash"
  },
  "visibility": {
   "clear": "no fog, haze or dense smoke over the scene",
   "smoke_or_fog": "fog, haze or dense smoke covers part of the scene"
  },
  "distance": {
   "near": "the fire or smoke fills a large part of the frame",
   "far": "the fire or smoke is a small part of a wide scene"
  },
  "setting": {
   "indoor": "inside a building or a studio",
   "outdoor": "outside"
  }
 },
