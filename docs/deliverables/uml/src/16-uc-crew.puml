@startuml
!include style.iuml
title Cas d'utilisation : application des équipes (P4a à P4d)
left to right direction
actor "Chef d'agrès\n(application des équipes, P4a, P4b)" as TL
actor "Auditeur prévention\n(application des équipes, P4c)" as AU
rectangle "Application des équipes (P4a à P4d)" {
  usecase "Se connecter par code\n(MFA, PIN 6 chiffres)" as T0
  usecase "Prendre la garde\n(engin, équipage)" as T1
  usecase "Accuser réception\nd'une mission" as T2
  usecase "En route / sur place /\nfin de mission" as T3
  usecase "Premier bilan < 30 s" as T4
  usecase "Compter les victimes,\névacuations" as T5
  usecase "Point de situation\npar touches (P4b)" as T6
  usecase "Demander un renfort,\nsignaler un danger (P4b)" as T7
  usecase "Joindre photo,\nvoix, texte (P4b)" as T8
  usecase "Rapport détaillé\nselon le modèle (P4b)" as T9
  usecase "Prendre une visite de\nprévention, hors ligne (P4c)" as T10
  usecase "Grille par touches\net photos (P4c)" as T11
  usecase "Signatures des deux\nparties (P4c)" as T12
  usecase "Décider, réserves\net délais (P4c)" as T13
  usecase "Travailler sans réseau,\nenvoi ordonné (P4d)" as T14
  usecase "Envoyer par SMS signé\n(P4d)" as T15
  usecase "Être suivi en route\net sur place (P4d)" as T16
}
actor "Citoyen signalant" as CIT
usecase "Être informé :\néquipe en route, arrivée (P4d)" as C38
TL --> T1
TL --> T2
TL --> T3
TL --> T4
TL --> T5
TL --> T6
TL --> T7
TL --> T8
TL --> T9
AU --> T10
AU --> T11
AU --> T12
AU --> T13
TL --> T14
TL --> T15
TL --> T16
T15 ..> T14 : <<extend>>
CIT --> C38
T10 ..> T0 : <<include>>
T11 ..> T10 : <<include>>
T13 ..> T12 : <<include>>
T1 ..> T0 : <<include>>
@enduml
