@startuml
!include style.iuml
title Cas d'utilisation : établissements (portail et application, P2a, P2b et P3a)
left to right direction
actor "Responsable\nd'établissement" as ADM
actor "Membre d'équipe\nde sécurité" as MEM
actor "Public" as PUB
actor "Auditeur\nd'établissements" as AUD
actor "Rédacteur\n(Office)" as RED
actor "Opérateur\n(salle)" as OPE
ADM -|> MEM
rectangle "Portail et application" {
  usecase "Enregistrer l'établissement\n(5 étapes)" as O1
  usecase "Classement automatique\net éléments manquants" as O2
  usecase "Gérer l'équipe de sécurité\net les formations" as O3
  usecase "Déclarer matières dangereuses\n(n° ONU, FDS)" as O4
  usecase "Déclarer équipements\net maintenance" as O5
  usecase "Placer points sur la carte\n(rassemblement, sorties)" as O6
  usecase "Déposer documents\nversionnés" as O7
  usecase "Inviter des membres" as O8
  usecase "Signaler au nom\nde l'établissement" as O9
  usecase "Demander le certificat\nde sécurité" as O10
  usecase "Vérifier un certificat\n(code / QR)" as O11
  usecase "Approuver l'établissement\n(et corriger le type)" as O12
  usecase "S'enregistrer depuis le téléphone\n(4 étapes, champs du type)" as O14
  usecase "Suivre la préparation\net les alertes" as O15
  usecase "Noter une maintenance\navec photo (P2b)" as O16
  usecase "Confirmer la lecture\nd'un message de l'Office (P2b)" as O17
  usecase "Lire la sensibilisation\nde son type (P2b)" as O18
  usecase "Noter un exercice /\ndéclarer un événement (P2b)" as O19
  usecase "Écrire à des types\nd'établissements, accusé demandé (P2b)" as O20
  usecase "Suivre les accusés\nde lecture (P2b)" as O21
  usecase "Voir les événements\npublics à venir (P2b)" as O22
  usecase "Valider / révoquer\nle certificat (Ed25519)" as O13
  usecase "Vérifier au guichet régional\n(QR, comparaison) (P3a)" as O23
  usecase "Cacheter à la main et\nenregistrer le cachet (P3a)" as O24
  usecase "Être rappelé du renouvellement\n(90 et 30 jours) (P3a)" as O25
  usecase "Voir « à mettre à jour »\net régénérer (P3a)" as O26
}
ADM --> O1
ADM --> O14
O14 ..> O2 : <<include>>
MEM --> O15
MEM --> O16
O16 ..> O5 : <<extend>>
O1 ..> O2 : <<include>>
MEM --> O3
MEM --> O4
MEM --> O5
MEM --> O6
MEM --> O7
ADM --> O8
MEM --> O9
ADM --> O10
PUB --> O11
AUD --> O12
AUD --> O13
MEM --> O17
MEM --> O18
MEM --> O19
RED --> O20
RED --> O21
O20 ..> O17 : <<include>>
OPE --> O22
O19 ..> O22 : <<extend>>
O10 ..> O13 : <<include>>
AUD --> O23
AUD --> O24
O24 ..> O23 : <<include>>
ADM --> O25
MEM --> O26
O26 ..> O10 : <<extend>>
@enduml
