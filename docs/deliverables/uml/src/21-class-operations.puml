@startuml
!include style.iuml
title Diagramme de classes : signalements, incidents et opérations
hide empty methods
class Signalement {
  id, code_suivi
  catégorie
  texte original [chiffré], langue
  traduction arabe [chiffrée]
  position, précision
  gouvernorat
  statut
  priorité 0..10, crédibilité
  créé_le, reçu_le
}
class Média {
  type : photo | vidéo | audio
  sha256, taille
  transcription [chiffrée]
  analyse
}
class HistoriqueStatut {
  statut, date
  acteur, note
}
class AnalyseIA {
  extraction, priorité
  crédibilité, suggestion
}
class FluxDirect {
  source, chemin
  statut, position
}
class Détection {
  libellé, confiance
  boîtes, confirmée
}
class Incident {
  catégorie, gravité
  centroïde, zone
  niveau opérationnel
  statut, titre
}
class ÉvénementChronologie {
  type, date, acteur
}
class Unité {
  nom, type
  gouvernorat, téléphone
}
class Moyen {
  type, libellé
  statut
}
class Affectation {
  type, ordre
  statut
  en route, sur place, libéré
}
class Mobilisation {
  compétence, rayon_km
  message, statut
}
class CibleMobilisation {
  distance, statut
  ETA, arrivé_le
}
class DemandeRenfort {
  de / vers gouvernorat
  type, quantité
  statut, motif
}
class NiveauGouvernorat {
  niveau : normal | vigilance | crise
  depuis, motif
}
class Directive {
  titre, urgence
  gouvernorats
}
class Garde <<P4a>> {
  chef d'agrès, équipage
  début, fin
}
class TéléphoneÉquipe <<P4a, P4d>> {
  titulaire, plateforme, jeton push
  clé SMS (chiffrée, P4d)
  dernier contact, retiré_le
}
class ÉvénementÉquipe <<P4a, P4d>> {
  client_id (unique), type
  heure du téléphone (≤ 12 h)
  via : app | sms
}
class PositionÉquipe <<P4d>> {
  heure, position, précision
  conservée 30 jours
}
class RapportTerrain <<P4a, P4b>> {
  type : premier, mise à jour, détaillé
  catégorie, gravité 1..4
  renforts (types), danger équipage
  réponses au modèle, note
}
class CompteurVictimes <<P4a, P4b>> {
  blessés légers, blessés graves
  décédés, secourus, bloqués
}
class Évacuation <<P4a, P4b>> {
  triage, tranche d'âge
  sexe, hôpital (couche ou texte, sans nom)
}
class AlerteÉquipe <<P4b, P4d>> {
  renfort | danger, éléments
  via : app | sms
  vue_par, vue_le
}
class PièceJointe <<P4b>> {
  photo | voix | texte
  taille, durée, clé S3
}
class ModèleRapport <<P4b>> {
  catégorie, version
  brouillon | approuvé | retiré
  questions (ar, fr, en), simulé
}
class Prévision {
  type, modèle
  résultat, simulé
}
class Appel {
  direction, numéro [chiffré]
  opérateur, statut
}
Signalement "1" *-- "*" Média
Signalement "1" *-- "*" HistoriqueStatut
Signalement "1" -- "0..1" AnalyseIA
Signalement "1" -- "*" FluxDirect
FluxDirect "1" *-- "*" Détection
Incident "1" o-- "1..*" Signalement : regroupe
Incident "1" *-- "*" ÉvénementChronologie
Incident "1" -- "*" Affectation
Incident "1" -- "*" Mobilisation
Incident "1" -- "*" DemandeRenfort
Incident "1" -- "*" Prévision
Unité "1" *-- "*" Moyen
Affectation "*" --> "0..1" Moyen
Mobilisation "1" *-- "*" CibleMobilisation
CibleMobilisation "*" --> "1" "Bénévole"
Affectation "*" --> "0..1" "Bénévole"
Directive "*" --> "*" NiveauGouvernorat
Appel "*" --> "0..1" Signalement : rattaché à
Garde "*" --> "1" Moyen
Garde "*" --> "1" TéléphoneÉquipe
Affectation "*" --> "0..1" Garde : accusé_le
Affectation "1" *-- "*" ÉvénementÉquipe
Affectation "1" *-- "*" PositionÉquipe
Affectation "1" *-- "*" RapportTerrain
RapportTerrain "*" --> "0..1" ModèleRapport : version
Affectation "1" *-- "*" AlerteÉquipe
Affectation "1" *-- "*" PièceJointe
Incident "1" -- "0..1" CompteurVictimes
Affectation "1" *-- "*" Évacuation
class "Axe (L3)" as Axe {
  numéro : AX-AAAA-NNN
  nom, type, niveau 1..4
  gouvernorat (vide = national)
  emprise : polygone
  plan, statut, bilan
  prochain_point
}
class "DemandeDéclaration" as DemandeDecl {
  motif, type, emprise proposée
  statut : en attente | acceptée | refusée
}
class "DirectiveAxe" as DirAxe {
  type : recommandation | décision
  catégorie, texte, emprise
  exécutant, échéance
  statut, motif
  signature Ed25519, id de clé
  remplacée_par
}
class "PointSituation" as Sitrep {
  numéro, chiffres calculés
  appréciation, envoyé_le
}
class "Abri" as Abri {
  nom, lieu, capacité, occupants
}
class "ZoneÉvacuation" as ZoneEvac {
  emprise, évacués
}
class "BesoinMoyens" as Besoin {
  libellé, quantité, statut
}
Axe "0..1" o-- "*" Axe : parent national
Axe "1" o-- "*" Incident : rattachées
Axe "1" *-- "*" DirAxe
Axe "1" *-- "*" Sitrep
Axe "1" *-- "*" Abri
Axe "1" *-- "*" ZoneEvac
Axe "1" *-- "*" Besoin
DemandeDecl "*" --> "0..1" Axe : ouvre
DirAxe "*" --> "0..1" DirAxe : en conflit avec
@enduml
