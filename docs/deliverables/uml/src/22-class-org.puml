@startuml
!include style.iuml
title Diagramme de classes : établissements et certificat de sécurité
hide empty methods
class Établissement {
  nom
  {field} type : 12 types (P2a) [SIM]
  {field} champs du type (kind_fields)
  {field} type à revoir (kind_review)
  identifiant [MF / RNE]
  secteur, capacité
  étages, hauteur
  reçoit du public
  adresse, position
  statut : brouillon | soumis | actif | suspendu
}
class Membre {
  rôle : admin | gestionnaire | membre
  rejoint_le
}
class Invitation {
  email, rôle
  expire_le, acceptée_le
}
class MembreÉquipeSécurité {
  nom, rôle, poste
  téléphone
  dernière formation
}
class MatièreDangereuse {
  nom, n° ONU
  classe, quantité, unité
  lieu de stockage
}
class Équipement {
  type, nombre
  emplacement
  dernière maintenance
}
class Maintenance <<P2b>> {
  réalisée le (pas dans le futur)
  note
  notée par, notée le
}
class Activité <<P2b>> {
  type : exercice | événement public
  titre
  début, fin (événement)
  participants, notes
  saisie par
}
class AccuséLecture <<P2b>> {
  confirmé par
  confirmé le
}
class MessageOffice <<P2b>> {
  public : établissements
  {field} types visés (vide : tous)
  accusé demandé
}
class PointCarte {
  type : rassemblement | sortie | prise d'eau
  position
}
class Document {
  type : dossier sécurité | plan | FDS | photo de maintenance
  titre
}
class VersionDocument {
  version, fichier
  sha256, statut
}
class Certificat {
  code
  statut : brouillon | soumis | approuvé | rejeté | révoqué
  instantané, empreinte
  signature Ed25519
  PDF sha256
  valide jusqu'au
  {field} rappels 90 / 30 jours (P3a)
  {field} à mettre à jour <<calculé>> (P3a)
  {field} type : sécurité | prévention (P3b)
}
class VisitePrévention {
  origine : demande | Office
  statut : demandée | programmée | inspectée | décidée | annulée
  date prévue, inspecteur
  date d'inspection, présents
  déclaré (instantané), constats
  rapport de comparaison <<calculé>>
  décision : favorable | réserves | refus motivé
  procès-verbal PDF sha256
  {field} inspecteur sur téléphone, client_id d'inspection (P4c)
  {field} signatures PNG inspecteur et représentant,\nnom et qualité du représentant (P4c)
}
class PhotoVisite {
  point de la grille
  clé de stockage, sha256, taille
  client_id unique
  prise par, le (téléphone) (P4c)
}
class Réserve {
  texte, point de la grille
  délai [≤ 12 mois]
  réponse de l'établissement
  levée par, note
  {field} état : ouverte | répondue | en retard | levée <<calculé>>
}
class CachetManuel {
  lieu, gouvernorat
  date du cachet
  note
  agent (identifiant, nom)
  photo sha256 (JPEG ou PNG)
  écarts au moment du cachet
}
class Classement <<calculé>> {
  famille : IGH | industriel | ERP | travail
  catégorie
  exigences manquantes
  {field} préparation % (P2a)
}
class ChampDuType <<référence>> {
  clé, type : entier | oui/non | texte
  visibilité : public | établissement et Office | signalement proche
  maximum
}
Établissement "1" *-- "1..*" Membre
Établissement "1" *-- "*" Invitation
Établissement "1" *-- "*" MembreÉquipeSécurité
Établissement "1" *-- "*" MatièreDangereuse
Établissement "1" *-- "*" Équipement
Équipement "1" *-- "*" Maintenance
Maintenance "*" --> "0..1" Document : photo
Établissement "1" *-- "*" Activité
MessageOffice "1" *-- "*" AccuséLecture
AccuséLecture "*" --> "1" Établissement
Établissement "1" *-- "*" PointCarte
Établissement "1" *-- "*" Document
Document "1" *-- "1..*" VersionDocument
MatièreDangereuse "*" --> "0..1" Document : FDS
Établissement "1" -- "*" Certificat
Certificat "1" *-- "*" CachetManuel : P3a
Établissement "1" *-- "*" VisitePrévention : P3b
VisitePrévention "1" *-- "*" Réserve
VisitePrévention "1" *-- "0..20" PhotoVisite : P4c
VisitePrévention "1" --> "0..1" Certificat : certificat de prévention
Établissement ..> Classement
Établissement ..> "*" ChampDuType : selon le type
Membre "*" --> "1" "Compte"
@enduml
