@startuml
!include style.iuml
title Diagramme de classes : alertes, contenus, récompenses et traçabilité
hide empty methods
class Message {
  type : info | alerte
  titre, corps [ar/fr/en]
  canaux, gravité
  zone : polygone | gouvernorats
  expire_le
}
class Envoi {
  canal : push | SMS | email
  statut, envoyés, échecs
}
class SuggestionMétéo {
  métrique, gravité
  période, statut, simulé
}
class ConseilSécurité {
  danger, contenu [3 langues]
  statut
}
class ThèmeGuide {
  clé, titre, icône
}
class ÉlémentGuide {
  contenu, appeler 198 si…
  validé par / le
}
class CoucheCarte {
  clé, nom, licence, simulée
  statut : brouillon | publiée | suspendue
  publics : citoyen, salles, terrain,
    commandement, soutien
  portée : gouvernorats, sensible
  champs : colonne → publics
  supprimée_le, motif (30 jours)
}
class "FondDeCarte (R-S)" as FondCarte {
  fournisseur, modèle d'adresse (https)
  clé de licence (chiffrée, jamais rendue)
  en-tête de la clé, attribution
  zoom max, activé, dernier test
  -- à défaut : imagerie ouverte EOX
}
class "LieuEnregistré (M)" as LieuEnr {
  nom (1..120), type : critique | important | autre
  note (≤ 2000), lat, lon
  gouvernorat, délégation (déduits)
  créé par, modifié par, dates
  -- RLS par gouvernorat ; audit place.*
}
class DossierCouches {
  clé, noms (ar, fr, en)
  icône, couleur, ordre
  sensible
  -- n'accorde aucun droit (UI-3b)
}
class RévisionCouche {
  numéro, action, instantané
  motif, auteur, date
}
class ÉlémentCouche {
  nom, type, téléphone
  position, forme (ligne | surface)
  statut du nom, nom proposé, confiance
  lien OSM, doublon possible
  supprimé_le, motif
}
class Plage {
  direction du large
  météo marine : dernière, prochaine
}
class HeureMarine {
  heure, vagues (hauteur, période, direction)
  température de la mer, courant
  simulée
}
class RisqueJour {
  jour, score 0..100
  niveau : vert | jaune | rouge
  facteurs (code, points, valeur)
}
class AlerteCôtière {
  jour, niveau, niveau précédent
  vue par, vue le
}
class RèglesCôtières {
  seuils jaune / rouge
  points par facteur
  modifié par, le
}
class PrésenceAnonyme {
  empreinte du jeton du jour
  vu le (effacée après 24 h)
}
class Programme {
  code, type, intitulé, saison
  début, fin, statut, version
  totaux déclarés
  approuvé par, approuvé le
  motif d'annulation
}
class PointProgramme {
  référence, gouvernorat, lieu
  position, précision de la position
  agents, sauveteurs prévus et déployés
  horaires, statut
  responsable et téléphone (salles seulement)
}
class RévisionProgramme {
  numéro, action, motif
  auteur, date
  instantané complet
}
class RègleRécompense {
  motif, catégorie
  points, multiplicateur
}
class MouvementPoints {
  delta, motif
  plafonné
}
class Badge {
  niveau : bronze | argent | or | ambassadeur
  statut
}
class CertificatDistinction {
  code, distinction
  signature
}
class JournalAudit {
  seq, date, acteur
  action, cible, motif
  hash précédent, hash
}
class AncrePreuve {
  racine Merkle
  signature, jeton TSA
}
class MémoireNationale {
  titre, période
  forces, faiblesses
  leçons, recommandations
}
Message "1" *-- "*" Envoi
SuggestionMétéo ..> Message : devient
ThèmeGuide "1" *-- "*" ÉlémentGuide
CoucheCarte "1" *-- "*" ÉlémentCouche
CoucheCarte "1" *-- "*" RévisionCouche
DossierCouches "1" o-- "*" CoucheCarte : dossier (ou celui que\nsa clé suggère, UI-3b)
ÉlémentCouche "1" -- "0..1" Plage : couche des plages
Plage "1" *-- "*" HeureMarine
Plage "1" *-- "*" RisqueJour
Plage "1" -- "*" AlerteCôtière
Plage "1" -- "*" PrésenceAnonyme
RèglesCôtières ..> RisqueJour : calcule
Programme "1" *-- "*" PointProgramme
Programme "1" *-- "*" RévisionProgramme
Programme "1" -- "0..1" CoucheCarte : couche datée (L2)
PointProgramme ..> RisqueJour : plage surveillée à 1 km
RègleRécompense "1" -- "*" MouvementPoints
"Compte" "1" -- "*" MouvementPoints
"Compte" "1" -- "*" Badge
Badge "1" -- "0..1" CertificatDistinction
JournalAudit "*" --> "1" AncrePreuve : ancré par
MémoireNationale "*" --> "*" "Incident"
@enduml
